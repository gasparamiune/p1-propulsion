FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
dimensions [0 0 -1 0 0 0 0];
internalField uniform 100;
boundaryField
{
    inlet { type fixedValue; value uniform 15274.8; }
    nozzleWall { type omegaWallFunction; value uniform 100; }
    base { type omegaWallFunction; value uniform 100; }
    body { type omegaWallFunction; value uniform 100; }
    coflow { type fixedValue; value uniform 100; }
    farfield { type inletOutlet; inletValue uniform 100; value uniform 100; }
    outlet { type inletOutlet; inletValue uniform 100; value uniform 100; }
    axis { type empty; }
    front { type wedge; }
    back { type wedge; }
}
