    br = union_all([box((12.0, -12.0, 10.0), (58.5, 12.0, 15.0)), box((54.5, -12.0, 10.0), (58.5, 12.0, 40.0))])
    out["FS-15"] = cut_all(br, [cyl_dir(5.5, 4.2, (54.4, vv, 30.0), (1, 0, 0)) for vv in (-6.0, 6.0)] +
                           [cyl(4.5, 9.9, 15.1, 15.5, vv) for vv in (-7.0, 7.0)])
    # FD-08F line flange (316L) and FD-12F tank flange (316L): socket 9.6 x 4.5, AS568-012 groove on the mating face
