                            cyl_dir(13.0, 1.3, (u0 - sgn * 0.01, 0.0, w), (sgn, 0, 0)).cut(cyl_dir(9.4, 1.4, (u0 - sgn * 0.06, 0.0, w), (sgn, 0, 0)))]
                       + [cyl_dir(4.5, 6.2, (u0 - sgn * 0.1, vv, w), (sgn, 0, 0)) for vv in (-9.0, 9.0)])
    out["FD-08F"] = flange(18.0, +1.0, M["line_w"])
    fl = box((-14.0, -18.0, M["tank_w"] - 7.0), (14.0, -12.0, M["tank_w"] + 7.0))
    out["FD-12F"] = cut_all(fl, [cyl_dir(9.6, 4.51, (0.0, -18.01, M["tank_w"]), (0, 1, 0)), cyl_dir(7.75, 6.1, (0.0, -18.05, M["tank_w"]), (0, 1, 0)),
