# ------------------------------------------------------------------------------------------------ small helpers
def pol(r, az_deg, z):
    a = math.radians(az_deg)
    return np.array([r * math.cos(a), r * math.sin(a), z])


def _unit(v):
    v = np.asarray(v, float)
    return v / np.linalg.norm(v)


def smooth_curve(points, d0, d1, step=1.0):
    """C2 cubic spline through `points` (chord-length parameter) with unit end tangents d0, d1; returns points every ~step mm."""
    from scipy.interpolate import make_interp_spline
    P = np.asarray(points, float)
    s = np.concatenate([[0.0], np.cumsum(np.linalg.norm(np.diff(P, axis=0), axis=1))])
    sp = make_interp_spline(s, P, k=3, bc_type=([(1, _unit(d0))], [(1, _unit(d1))]))
    n = max(8, int(math.ceil(s[-1] / step)))
    return sp(np.linspace(0.0, s[-1], n + 1))


def curvature_radius(pts):
    """Discrete radius of curvature at the interior points (mm)."""
    P = np.asarray(pts, float)
    out = np.full(len(P), np.inf)
    for i in range(1, len(P) - 1):
        a, b, c = P[i - 1], P[i], P[i + 1]
        ab, bc, ac = np.linalg.norm(b - a), np.linalg.norm(c - b), np.linalg.norm(c - a)
        A2 = np.linalg.norm(np.cross(b - a, c - a))
        if A2 > 1e-12:
            out[i] = ab * bc * ac / (2.0 * A2)
    return out


def sweep_tube(pts, od, idd=None):
    """Tube (or rod) swept along one interpolating spline through pts (single spline: valid OCC solid)."""
    P = np.asarray(pts, float)
    idx = np.unique(np.r_[np.arange(0, len(P), 2), len(P) - 1])          # every 2nd sample of a ~1 mm polyline
    if len(idx) > 2 and idx[-1] - idx[-2] < 2:
        idx = np.delete(idx, -2)
    vecs = [cq.Vector(*map(float, P[i])) for i in idx]
    t0 = _unit(P[1] - P[0])
    edge = cq.Edge.makeSpline(vecs)                                       # no end-tangent constraint: with it OCC returned void solids
    path = cq.Wire.assembleEdges([edge])
    outer = cq.Wire.makeCircle(od / 2.0, cq.Vector(*P[0]), cq.Vector(*t0))
    inner = [cq.Wire.makeCircle(idd / 2.0, cq.Vector(*P[0]), cq.Vector(*t0))] if idd else []
    return cq.Solid.sweep(outer, inner, path, makeSolid=True, isFrenet=False, transitionMode="right")


def plan_curve(Q, psi0, F, psi1, kmax, rmax, r_pref, n_c=14, n_s=400):
    """Plan-view centreline from Q (heading psi0, rad) to F (heading psi1) turning clockwise: curvature as a cubic B-spline in the
    arc length, end position/heading as equality constraints, kappa <= kmax and r <= rmax as inequalities; objective = curvature
    variation + a penalty on r above r_pref (SLSQP).  Returns (s, x, y, psi, kappa, success)."""
    from scipy.optimize import minimize
    from scipy.interpolate import BSpline
    dpsi = (psi0 - psi1) % (2 * math.pi)
    k = 3
    t = np.r_[[0.0] * k, np.linspace(0.0, 1.0, n_c - k + 1), [1.0] * k]
    def geom(xv):
        L, c = xv[-1], xv[:-1]
        sig = np.linspace(0.0, 1.0, n_s + 1)
        kap = BSpline(t, c, k)(sig)
        ds = L / n_s
        psi = psi0 - np.concatenate([[0.0], np.cumsum(0.5 * (kap[1:] + kap[:-1]) * ds)])
        x = Q[0] + np.concatenate([[0.0], np.cumsum(0.5 * (np.cos(psi[1:]) + np.cos(psi[:-1])) * ds)])
        y = Q[1] + np.concatenate([[0.0], np.cumsum(0.5 * (np.sin(psi[1:]) + np.sin(psi[:-1])) * ds)])
        return sig * L, x, y, psi, kap
    def obj(xv):
        s_, x, y, psi, kap = geom(xv)
        ds = xv[-1] / n_s
        return float(np.sum((np.diff(kap) / ds) ** 2) * ds) * 1e4 + 0.02 * float(np.sum(np.maximum(np.hypot(x, y) - r_pref, 0.0) ** 2) * ds)
    L0 = 1.2 * dpsi * 50.0
    x0 = np.r_[np.full(n_c, dpsi / L0), L0]
    cons = [{"type": "eq", "fun": lambda xv: (lambda g: np.array([g[1][-1] - F[0], g[2][-1] - F[1],
                                                               (g[3][-1] - psi1 + math.pi) % (2 * math.pi) - math.pi]))(geom(xv))},
            {"type": "ineq", "fun": lambda xv: kmax - geom(xv)[4]},
            {"type": "ineq", "fun": lambda xv: geom(xv)[4] + 0.002},
            {"type": "ineq", "fun": lambda xv: rmax - np.hypot(geom(xv)[1], geom(xv)[2])}]
    r = minimize(obj, x0, method="SLSQP", constraints=cons, options={"maxiter": 500, "ftol": 1e-10})
    s_, x, y, psi, kap = geom(r.x)
    return s_, x, y, psi, kap, bool(r.success)


def resample(P, step=1.0):
    """Uniform arc-length resampling of a polyline."""
    P = np.asarray(P, float)
    s = np.concatenate([[0.0], np.cumsum(np.linalg.norm(np.diff(P, axis=0), axis=1))])
    n = max(2, int(math.ceil(s[-1] / step)))
    si = np.linspace(0.0, s[-1], n + 1)
    return np.column_stack([np.interp(si, s, P[:, j]) for j in range(3)])


def rot_z(v, deg):
    a = math.radians(deg)
    return np.array([math.cos(a) * v[0] - math.sin(a) * v[1], math.sin(a) * v[0] + math.cos(a) * v[1], v[2]])


def seg_points(segs, step=1.0, step_deg=0.5):
    """Polyline of a list of exact segments: ('line', p0, p1) and ('arc', centre, axis, p_start, angle_deg)."""
    out = []
    for sg in segs:
        if sg[0] == "line":
            p0, p1 = np.asarray(sg[1], float), np.asarray(sg[2], float)
            n = max(1, int(math.ceil(np.linalg.norm(p1 - p0) / step)))
            pts = [p0 + (p1 - p0) * k / n for k in range(n + 1)]
        else:
            C, ax, p0, ang = np.asarray(sg[1], float), _unit(sg[2]), np.asarray(sg[3], float), sg[4]
            n = max(2, int(math.ceil(abs(ang) / step_deg)))
            v = p0 - C
            pts = []
            for k in range(n + 1):
                t = math.radians(ang * k / n)
                pts.append(C + v * math.cos(t) + np.cross(ax, v) * math.sin(t) + ax * (ax @ v) * (1 - math.cos(t)))
        out += pts if not out else pts[1:]
    return np.array(out)


def tube_segments(segs, od, idd):
    """Exact tube along line/arc segments.  v3.4.1: one annulus swept along the G1 line/arc wire (the v3.4 'union of rods minus union of
    bores' returned the SOLID rods: OCC dropped the bore cut silently, FD-08 weighed 159 g instead of 54 g and had no bore - found by the
    segment_traps_v341 CAD-consistency check).  Falls back to per-segment annuli; the result is checked against A x L."""
    def path_wire():
        edges = []
        for sg in segs:
            if sg[0] == "line":
                p0, p1 = np.asarray(sg[1], float), np.asarray(sg[2], float)
                if np.linalg.norm(p1 - p0) > 1e-6:
                    edges.append(cq.Edge.makeLine(cq.Vector(*p0), cq.Vector(*p1)))
            else:
                C, ax, p0, ang = np.asarray(sg[1], float), _unit(sg[2]), np.asarray(sg[3], float), sg[4]
                rv = lambda a: C + _rodrigues(p0 - C, ax, a)
                edges.append(cq.Edge.makeThreePointArc(cq.Vector(*p0), cq.Vector(*rv(0.5 * ang)), cq.Vector(*rv(ang))))
        return cq.Wire.assembleEdges(edges)
    L = 0.0
    for sg in segs:
        L += float(np.linalg.norm(np.asarray(sg[2], float) - np.asarray(sg[1], float))) if sg[0] == "line" else \
            math.radians(sg[4]) * float(np.linalg.norm(np.asarray(sg[3], float) - np.asarray(sg[1], float)))
    v_ref = math.pi / 4.0 * (od ** 2 - idd ** 2) * L
    first = segs[0]
    p0 = np.asarray(first[1] if first[0] == "line" else first[3], float)
    t0 = _unit(np.asarray(first[2], float) - p0) if first[0] == "line" else \
        _unit(np.cross(_unit(first[2]), p0 - np.asarray(first[1], float)))
    try:
        w = path_wire()
        outer = cq.Wire.makeCircle(od / 2.0, cq.Vector(*p0), cq.Vector(*t0))
        inner = cq.Wire.makeCircle(idd / 2.0, cq.Vector(*p0), cq.Vector(*t0))
        sol = cq.Solid.sweep(outer, [inner], w, makeSolid=True, isFrenet=False, transitionMode="right")
        if sol.isValid() and abs(sol.Volume() - v_ref) < 0.01 * v_ref:
            return sol
    except Exception:
        pass
    fb = _tube_segments_v34(segs, od, idd)
    v_fb = sum(x.Volume() for x in fb.Solids())
    if abs(v_fb - v_ref) > 0.01 * v_ref:
        raise RuntimeError(f"tube_segments: sweep and fallback both failed the volume check ({v_fb:.0f} vs {v_ref:.0f} mm3)")
    return fb


def _rodrigues(v, k, deg):
    a = math.radians(deg)
    v = np.asarray(v, float)
    return v * math.cos(a) + np.cross(k, v) * math.sin(a) + k * (k @ v) * (1.0 - math.cos(a))


def _tube_segments_v34(segs, od, idd):
    """Fallback: per-segment annulus (outer minus a slightly longer bore), then the union (v3.4.1; the v3.4 union-then-cut lost the bore)."""
    pieces = []
    for sg in segs:
        if sg[0] == "line":
            p0, p1 = np.asarray(sg[1], float), np.asarray(sg[2], float)
            L = float(np.linalg.norm(p1 - p0))
            if L <= 1e-6:
                continue
            u = (p1 - p0) / L
            pieces.append(cyl_dir(od, L, tuple(p0), tuple(u)).cut(cyl_dir(idd, L + 0.2, tuple(p0 - 0.1 * u), tuple(u))))
        else:
            C, ax, p0, ang = np.asarray(sg[1], float), _unit(sg[2]), np.asarray(sg[3], float), sg[4]
            tg = _unit(np.cross(ax, p0 - C))
            o = cq.Solid.revolve(cq.Wire.makeCircle(od / 2.0, cq.Vector(*p0), cq.Vector(*tg)), [], float(ang), cq.Vector(*C), cq.Vector(*(C + ax)))
            q0 = C + _rodrigues(p0 - C, ax, -0.2)
            tq = _unit(np.cross(ax, q0 - C))
            i_ = cq.Solid.revolve(cq.Wire.makeCircle(idd / 2.0, cq.Vector(*q0), cq.Vector(*tq)), [], float(ang) + 0.4, cq.Vector(*C), cq.Vector(*(C + ax)))
            pieces.append(o.cut(i_))
    return union_all(pieces).clean()


def arc_pts(c, e1, e2, R, a0, a1, step_deg=3.0):
    """Points on a circular arc centre c, radius R, in the plane (e1, e2): angle a0 -> a1 (deg)."""
    n = max(2, int(math.ceil(abs(a1 - a0) / step_deg)))
    return [c + R * (math.cos(math.radians(a)) * e1 + math.sin(math.radians(a)) * e2) for a in np.linspace(a0, a1, n + 1)]


# ------------------------------------------------------------------------------------------------ frozen plan curve (v3.4.1)
# The SLSQP plan curve is ill-conditioned: with multi-threaded OpenBLAS (OMP_NUM_THREADS >= 2) the v3.4.1 coil diverges (length -781 mm),
# single-threaded it converges (180.25 mm) - found 2026-10-13.  The baseline plan is therefore FROZEN in data/feed_plan_v341.json
# (written by `OMP_NUM_THREADS=1 python parts_feed.py --freeze-plan`) and used whenever the route inputs match its key; studies with
# other inputs still optimise (run them single-threaded).
PLAN_FROZEN = Path(__file__).resolve().parent / "data" / "feed_plan_v341.json"
LAST_PLAN = {}


def _plan_key(Q, psi0, Fq, psi1, c):
    return [round(float(v), 4) for v in (Q[0], Q[1], psi0, Fq[0], Fq[1], psi1, c["R_min_plan"], c["r_max"], c["r_pref"])]


def _frozen_plan(key):
    try:
        d = json.loads(PLAN_FROZEN.read_text())
    except (OSError, ValueError):
        return None
    return d if d.get("key") == key else None


# ------------------------------------------------------------------------------------------------ route
def route(S):
    """All feed centrelines and stations (engine frame, neutral).  Stored in S['feed']."""
    t = FEED["tee"]
    ax, ay = t["axis_xy"]
    zs = t["side_z"]
    Pe = np.array([ax, 8.0, zs])                                   # side-socket mouth on the TEE +Y face
    # d = (sin th, cos th, 0) with Pe . d = side_aim
    f = lambda th: ax * math.sin(th) + 8.0 * math.cos(th) - t["side_aim"]
    lo, hi = 0.0, 1.2
    for _ in range(60):
        mid = 0.5 * (lo + hi)
        lo, hi = (mid, hi) if f(lo) * f(mid) > 0 else (lo, mid)
    th = 0.5 * (lo + hi)
    d = np.array([math.sin(th), math.cos(th), 0.0])
    fe = FEED["ferrule"]
    Q = Pe + (fe["stub"] + fe["len"]) * d                          # flexible hose starts here (engine side)
    c = FEED["coil"]
    Fq = pol(c["fq_r"], c["fq_az"], c["z_end"])                     # flexible hose ends here (fixed side)
    tang = np.array([math.sin(math.radians(c["fq_az"])), -math.cos(math.radians(c["fq_az"])), 0.0])   # clockwise tangent
    c1, c2 = rot_z(tang, c["ferrule_in_deg"]), rot_z(tang, -c["ferrule_in_deg"])
    cdir = c1 if np.linalg.norm((Fq + 28.0 * c1)[:2]) < np.linalg.norm((Fq + 28.0 * c2)[:2]) else c2        # inward of the tangent
    Fe = Fq + (fe["len"] + fe["stub"]) * cdir                     # fixed end of the sleeve stub (butt weld to FD-08)
    # hose: optimised plan curve (R >= R_min_plan, r <= r_max) + quintic z from the TEE side height to z_end
    psi0, psi1 = math.atan2(d[1], d[0]), math.atan2(cdir[1], cdir[0])
    key = _plan_key(Q, psi0, Fq, psi1, c)
    fz = None if FEED.get("no_frozen_plan") else _frozen_plan(key)
    if fz is not None:
        s_, x_, y_ = (np.asarray(fz[k], float) for k in ("s", "x", "y"))
        ok, plan_err = bool(fz["ok"]), tuple(fz["plan_err"])
        sig = s_ / s_[-1]
    else:
        s_, x_, y_, psi_, kap_, ok = plan_curve(Q[:2], psi0, Fq[:2], psi1, 1.0 / c["R_min_plan"], c["r_max"], c["r_pref"])
        if not np.isfinite(s_[-1]) or not (20.0 < s_[-1] < 1000.0):        # v3.4.1 guard: a diverged SLSQP plan (8e8 mm) exhausted memory
            raise RuntimeError(f"feed route: plan curve diverged (length {s_[-1]:.3g} mm); with OpenBLAS threads > 1 the SLSQP plan is not "
                               "reproducible: run single-threaded (OMP_NUM_THREADS=1) or use the frozen plan (data/feed_plan_v341.json)")
        sig = s_ / s_[-1]
    # v3.4.1: SLSQP stops with end residuals of up to a few mm / degrees (coil_reroute_v341: 0-6 mm), i.e. the hose solid did not meet
    # the fixed ferrule exactly.  Close the plan curve on Fq and on the sleeve heading: position by a quintic smoothstep (zero slope at
    # both ends: start point and both end headings unchanged), heading by A s^2 (s - 1) along the end normal (start point/heading and
    # end point unchanged).  Residuals before closure are kept in S['feed'] (plan_end_err_mm, plan_end_heading_err_deg).
        e_xy = Fq[:2] - np.array([x_[-1], y_[-1]])
        psi_end = math.atan2(y_[-1] - y_[-2], x_[-1] - x_[-2])
        d_psi = (math.atan2(cdir[1], cdir[0]) - psi_end + math.pi) % (2 * math.pi) - math.pi
        n_end = np.array([-math.sin(psi_end), math.cos(psi_end)])
        hst = 10 * sig ** 3 - 15 * sig ** 4 + 6 * sig ** 5
        hrot = s_[-1] * d_psi * sig ** 2 * (sig - 1.0)
        x_ = x_ + e_xy[0] * hst + n_end[0] * hrot
        y_ = y_ + e_xy[1] * hst + n_end[1] * hrot
        plan_err = (float(np.linalg.norm(e_xy)), float(math.degrees(d_psi)))
    LAST_PLAN.clear()
    LAST_PLAN.update(key=key, s=[float(v) for v in s_], x=[float(v) for v in x_], y=[float(v) for v in y_], ok=bool(ok),
                     plan_err=[float(v) for v in plan_err], frozen=fz is not None)
    z_ = zs + (c["z_end"] - zs) * (10 * sig ** 3 - 15 * sig ** 4 + 6 * sig ** 5)
    hose = resample(np.column_stack([x_, y_, z_]), 1.0)
    # wall line: Fe -> L1 along cdir -> horizontal bend (R, alpha) -> L2 -> vertical 90 deg bend (R) -> vertical at (r_w, az_w)
    w = FEED["wall"]
    m = FEED["module"]
    R = w["R_bend"]
    T_xy = pol(w["r"], w["az"], 0.0)[:2]
    best = None
    for alpha in np.arange(c["wall_alpha_search"][0], c["wall_alpha_search"][1] + 1e-9, 0.05):
        if abs(alpha) < 0.05:
            continue
        P1 = Fe[:2] + c["wall_L1"] * cdir[:2]
        sg = 1.0 if alpha > 0 else -1.0
        nrm = np.array([-cdir[1], cdir[0]]) * sg
        Cc = P1 + R * nrm
        h = rot_z(cdir, alpha)[:2]
        P2 = Cc - R * np.array([-h[1], h[0]]) * sg
        dd = T_xy - P2
        L2 = float(dd @ h) - R
        lat = abs(dd[0] * h[1] - dd[1] * h[0])
        if L2 >= c["wall_L2_min"] and lat < 0.06 and (best is None or abs(alpha) < abs(best[0])):
            best = (alpha, L2, Cc, P1, P2, h, sg, nrm)
    if best is None:
        raise RuntimeError("feed route: no two-bend wall-line solution (move the fixed end)")
    alpha, L2, Cc, P1, P2, h, sg, nrm = best
    zf = Fe[2]
    P1_3, P2_3 = np.array([P1[0], P1[1], zf]), np.array([P2[0], P2[1], zf])
    Cc3 = np.array([Cc[0], Cc[1], zf])
    B = P2_3 + L2 * np.array([h[0], h[1], 0.0])
    h3 = np.array([h[0], h[1], 0.0])
    cv = B + R * np.array([0.0, 0.0, 1.0])
    V0 = cv + R * h3
    ur = pol(1.0, w["az"], 0.0)
    Vt = np.array([V0[0], V0[1], w["z_top_bend"]])
    ct = Vt - w["R_bend"] * ur
    top_end = ct + w["R_bend"] * np.array([0.0, 0.0, 1.0])
    z_line = w["z_top_bend"] + w["R_bend"]
    mod_c = pol(m["r"], m["az"], m["z0"])
    u_face, fl_t, sock = 18.0, 6.0, 4.5                            # module lower-body face, flange thickness, tube insertion
    end = mod_c + (u_face + fl_t - sock) * ur
    end[2] = z_line
    wall_segs = [("line", Fe, P1_3),
                 ("arc", Cc3, np.array([0.0, 0.0, sg]), P1_3, abs(alpha)),
                 ("line", P2_3, B),
                 ("arc", cv, _unit(np.cross(h3, [0.0, 0.0, 1.0])), B, 90.0),
                 ("line", V0, Vt),
                 ("arc", ct, _unit(np.cross([0.0, 0.0, 1.0], -ur)), Vt, 90.0),
                 ("line", top_end, end)]
    wall = seg_points(wall_segs)
    feed = dict(Pe=Pe, d=d, theta_deg=math.degrees(th), Q=Q, Fq=Fq, Fe=Fe, cdir=cdir, hose=hose, wall=wall, wall_segs=wall_segs, V0=V0,
                z_line_top=z_line, module_c=mod_c, module_ur=ur, module_ut=np.array([-ur[1], ur[0], 0.0]),
                hose_len_mm=float(np.sum(np.linalg.norm(np.diff(hose, axis=0), axis=1))),
                wall_len_mm=float(np.sum(np.linalg.norm(np.diff(wall, axis=0), axis=1))),
                hose_Rmin_mm=float(np.min(curvature_radius(hose))), wall_Rmin_mm=float(np.min(curvature_radius(wall))),
                coil_sweep_deg=float((math.degrees(math.atan2(Q[1], Q[0])) - math.degrees(math.atan2(Fq[1], Fq[0]))) % 360.0),
                tee_axis=(ax, ay), plan_opt_ok=ok, wall_alpha_deg=float(alpha), wall_L2_mm=float(L2), R_wall=R,
                plan_end_err_mm=plan_err[0], plan_end_heading_err_deg=plan_err[1], plan_frozen=fz is not None)
    S["feed"] = feed
    S["z_r0"] = t["z_top"]
    return feed


def module_T(S):
    f = S["feed"]
    return T_basis(f["module_c"], f["module_ur"], f["module_ut"], np.array([0.0, 0.0, 1.0]))


