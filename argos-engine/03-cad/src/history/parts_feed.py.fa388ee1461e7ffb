            cyl_dir(4.0, 15.5, (-24.0, 0.0, -10.0), (1, 0, 0)),                                    # cross passage to the chamber
            cyl_dir(11.1, 17.0, (0.0, 7.0, M["port_w"]), (0, 1, 0)),                               # disc port 1/4-18 NPT
            cyl_dir(8.7, 9.0, (0.0, -16.01, M["mss2_w"]), (0, 1, 0)),                              # MSS-2 1/8-27 NPT
            cyl(8.7, -20.01, ch0 + 0.01),                                                          # drain 1/8-27 NPT (flush plug)
