# ------------------------------------------------------------------------------------------------ posed flexible items
_HOSE_U = {}


def hose_modes(S, EI=None):
    """Linear frame displacement fields of the hose for a unit small rotation about X and Y (hose_frame.solve); cached."""
    import sys
    from pathlib import Path
    sys.path.insert(0, str(Path(__file__).resolve().parent / "calcs"))
    import hose_frame as hf
    EI = FEED["hose"]["EI_nom"] if EI is None else EI
    key = (EI, round(float(S["feed"]["Q"][2]), 3), len(S["feed"]["hose"]))
    if key in _HOSE_U:
        return _HOSE_U[key]
    nodes = S["feed"]["hose"][::3] * 1e-3
    if not np.allclose(nodes[-1], S["feed"]["hose"][-1] * 1e-3):
        nodes = np.vstack([nodes, S["feed"]["hose"][-1] * 1e-3])
    th = 1e-3
    kx, wx, bx, Ux = hf.solve(nodes, EI, axis=(1, 0, 0), theta=th)
    ky, wy, by, Uy = hf.solve(nodes, EI, axis=(0, 1, 0), theta=th)
    _HOSE_U[key] = (nodes, Ux / th, Uy / th, kx, ky, bx / th, by / th)
    return _HOSE_U[key]


def hose_centreline_at(S, alpha, beta, EI=None):
    """Hose centreline (mm) at the engine pose (alpha, beta) deg: linear frame superposition + exact rigid end correction blended
    along the arc length (engine end exact, fixed end fixed)."""
    import tvc_kinematics as tk
    nodes, Ux, Uy, *_ = hose_modes(S, EI)
    a, b = math.radians(alpha), math.radians(beta)
    U = a * Ux + b * Uy
    X = nodes + np.column_stack([U[0::6], U[1::6], U[2::6]])
    R = tk.R_pose(alpha, beta)
    exact0 = R @ nodes[0]
    corr = exact0 - X[0]
    s = np.concatenate([[0.0], np.cumsum(np.linalg.norm(np.diff(nodes, axis=0), axis=1))])
    X = X + np.outer(1.0 - s / s[-1], corr)
    return X * 1e3


def posed_flex(p, S, alpha, beta, i):
    if p.pn == "ENG-BL-04":                     # v3.5: bleed hose bundled above FD-07 (same pose model, offset rotated at the engine end)
        if abs(alpha) < 1e-9 and abs(beta) < 1e-9:
            return p.shape
        import parts_bleed, tvc_kinematics as tk
        pts = parts_bleed.hose_offset(S["feed"]["hose"], hose_centreline_at(S, alpha, beta), tk.R_pose(alpha, beta))
        return sweep_tube(pts, parts_bleed.BLEED["hose"]["od"], parts_bleed.BLEED["hose"]["id"])
    if p.pn != "ENG-FD-07":
        return apply(p.shape, np.eye(4))
    if abs(alpha) < 1e-9 and abs(beta) < 1e-9:
        return p.shape
    pts = hose_centreline_at(S, alpha, beta)
    return sweep_tube(pts, FEED["hose"]["od"], FEED["hose"]["id"])


