    dk = M["disc"]
    pop = union_all([cyl(dk["d"], -dk["t"], 0.0), cyl(M["stem_d"], -0.01, M["piston"]["w"][0] + 5.0)])
    out["FS-02"] = pop.cut(cyl(M["hole_d"], -dk["t"] - 0.01, M["piston"]["w"][0] + 5.01))
    # FS-04 piston + rod (balance hole continues, cross hole at w 28 into the balance chamber)
    pr = union_all([cyl(M["piston"]["d"] - 0.05, M["piston"]["w"][0], M["piston"]["w"][1]), cyl(M["rod"]["d"], M["piston"]["w"][1] - 0.01, 56.7)])
    pr = cut_all(pr, [cyl(M["stem_d"], M["piston"]["w"][0] - 0.01, M["piston"]["w"][0] + 5.0),           # M3 thread (stem)
                      cyl(M["hole_d"], M["piston"]["w"][0] + 4.9, M["cross_w"] + 0.6),
                      cyl_dir(M["hole_d"], 5.0, (-2.5, 0.0, M["cross_w"]), (1, 0, 0)),
                      tube(M["piston"]["d"] + 0.1, M["piston"]["d"] - 3.2, 20.0, 24.0),                  # seal groove 2.4 x 4
                      cyl(2.5, 50.7, 56.71)])                                                           # M3 for the follower screw
    out["FS-04"] = pr
    # FS-06 actuator housing (dry): spring pocket, follower bore, cam slot, bearing bores
    hz0 = M["body_top"]
    hs = box((-9.0, -12.0, hz0), (12.0, 12.0, 74.0))
    zc = 65.7
    out["FS-06"] = cut_all(hs, [cyl(18.0, hz0 + 2.0, 61.0), cyl(4.6, hz0 - 0.01, hz0 + 2.01), box((-4.0, -10.0, 59.0), (4.0, 10.0, 74.01)),
                                cyl_dir(8.0, 2.6, (-9.01, 0.0, zc), (1, 0, 0)), cyl_dir(8.0, 2.6, (5.2, 0.0, zc), (1, 0, 0)),
                                cyl_dir(9.8, 4.25, (7.8, 0.0, zc), (1, 0, 0)),                     # rev B: hub clearance (servo side)
                                cyl_dir(5.2, 21.1, (-9.05, 0.0, zc), (1, 0, 0))]
                           + [cyl(3.4, hz0 - 0.01, hz0 + 6.0, uu, vv) for (uu, vv) in ((8.5, 8.5), (8.5, -8.5), (-8.5, 8.5), (-8.5, -8.5))])
    # FS-07 spring (envelope coil as a tube 13.8/10.2, L_closed 20.7)
    out["FS-07"] = tube(13.8, 10.2, hz0 + 2.0, hz0 + 2.0 + 20.7)
    # FS-08 follower (17-4PH H900 flat, M3 to the rod)
    out["FS-08"] = cyl(16.0, 56.7, 59.7).cut(cyl(3.4, 56.69, 59.71))
    # FS-09 cam + shaft (cam r 6.0 -> 8.8 over 45 deg; shaft 5 in two MR85 bearings)
    prof = [(6.0 + 2.8 * min(1.0, max(0.0, a / 45.0)) if a <= 60 else 6.0) for a in range(0, 361, 5)]
    pre = MOD["cam_pretravel_deg"]                                 # rev B: closed state on the base circle, rise starts `pre` deg away
    cam_pts = [(r * math.sin(math.radians(a + pre)), zc - r * math.cos(math.radians(a + pre))) for a, r in zip(range(0, 361, 5), prof)]
    cam2d = cq.Workplane("YZ", origin=(-2.5, 0, 0)).polyline(cam_pts[:-1]).close().extrude(5.0).val()
    hub = cyl_dir(9.0, 4.3, (8.0, 0.0, zc), (1, 0, 0)).cut(cyl_dir(6.1, 3.72, (8.6, 0.0, zc), (1, 0, 0)))   # female-spline hub (at the major d)
    out["FS-09"] = union_all([cam2d, cyl_dir(5.0, 17.55, (-9.5, 0.0, zc), (1, 0, 0)), hub])
    # FS-10 servo SB-2292SG on the +u face (shaft along u, L vertical with the spline 10 mm below the top end)
    sx0 = 12.5
    out["FS-10"] = union_all([box((sx0, -10.1, zc - 30.3), (sx0 + 38.7, 10.1, zc + 10.0)), cyl_dir(6.0, 3.5, (sx0, 0.0, zc), (-1, 0, 0))])
    # FS-11 latch / release / dashpot / OPEN-CLOSED switches: reserved envelope (TO-DESIGN)
    out["FS-11"] = box((-8.0, -24.0, 40.0), (8.0, -12.0, 70.0))
    # FS-12 S1 back-relief check cartridge (envelope in its bore)
    out["FS-12"] = cyl(M["s1"]["cart_d"] - 0.1, M["s1"]["cart_w"][0] + 0.5, M["s1"]["cart_w"][1] - 0.5, s1u, s1v).cut(
        cyl(1.0, M["s1"]["cart_w"][0], M["s1"]["cart_w"][1], s1u, s1v))
    # FS-13 secondary rupture disc assembly (+v), FS-14 drain plug, EL P_feed and MSS-2 bodies
    out["FS-13"] = union_all([cyl_dir(11.0, 9.0, (0.0, 15.0, M["port_w"]), (0, 1, 0)), cyl_dir(22.0, 26.0, (0.0, 24.0, M["port_w"]), (0, 1, 0))])
    out["FS-14"] = cyl(8.6, -20.0, -13.0).cut(cyl(4.0, -20.01, -16.0))
    out["EL-PF"] = union_all([cyl(11.0, -2.0, 0.3, -24.0, 0.0), cyl(19.0, 0.3, 52.0, -24.0, 0.0)])
    out["EL-MS2"] = union_all([cyl_dir(8.6, 7.0, (0.0, -16.0, M["mss2_w"]), (0, 1, 0)), cyl_dir(12.7, 14.0, (0.0, -16.0, M["mss2_w"]), (0, -1, 0)),
