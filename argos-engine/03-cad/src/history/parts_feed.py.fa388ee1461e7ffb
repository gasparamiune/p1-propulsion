    s1u, s1v = M["s1"]["uv"]
    cuts = [cyl(M["seat"]["insert_od"], 0.29, M["seat"]["insert_t"]),                              # seat-insert counterbore
            cyl(M["seat"]["d"], 0.29, M["web_top"] + 0.01),                                         # seat orifice
            cyl(M["inlet"]["d"], M["web_top"], M["inlet"]["w"][1]),
            cyl(M["piston"]["d"], M["piston"]["w"][0] - 0.01, M["balance_top"]),
            cyl(M["rod"]["d"] + 0.05, M["balance_top"] - 0.01, M["body_top"] + 0.01),
            tube(M["rod"]["seal_od"], M["rod"]["d"], *M["rod"]["seal_w"]),
            cyl(M["s1"]["d"], 0.29, M["s1"]["cart_w"][0] + 0.01, s1u, s1v),
            cyl(M["s1"]["cart_d"], M["s1"]["cart_w"][0], M["s1"]["cart_w"][1], s1u, s1v),
            cyl_dir(7.75, 5.0, (0.0, -12.01, M["tank_w"]), (0, 1, 0))]                               # tank port passage (-v face)
    for (uu, vv) in ((11.0, 11.0), (11.0, -11.0), (-11.0, 11.0), (-11.0, -11.0)):
        cuts.append(cyl(3.3, 0.29, 10.3, uu, vv))                                                 # M4 tapped from below
    for uu in (-8.0, 8.0):
        cuts.append(cyl_dir(3.3, 7.0, (uu, -12.01, M["tank_w"]), (0, 1, 0)))                       # M4 for the tank flange
    for (uu, vv) in ((8.5, 8.5), (8.5, -8.5), (-8.5, 8.5), (-8.5, -8.5)):
        cuts.append(cyl(2.5, M["body_top"] - 8.0, M["body_top"] + 0.01, uu, vv))                  # M3 for the actuator housing
    out["FS-01B"] = cut_all(ub, cuts)
    # FS-03 PCTFE seat insert (land 11.5-12.5 protrudes 0.3 to the seat plane)
    out["FS-03"] = revolve([(M["seat"]["d"] / 2, 0.0), (M["seat"]["land_od"] / 2, 0.0), (M["seat"]["land_od"] / 2, 0.3),
                            (M["seat"]["insert_od"] / 2, 0.3), (M["seat"]["insert_od"] / 2, M["seat"]["insert_t"]),
