    spec.append(("cyl", L(*M["s1"]["uv"], 0.3), L(*M["s1"]["uv"], M["s1"]["cart_w"][0] + 0.5), M["s1"]["d"] / 2, "S1 check inlet passage (to the cartridge poppet)"))
    spec.append(("cyl", L(0, 0, -M["disc"]["t"]), L(0, 0, M["piston"]["w"][0] + 4.9), M["hole_d"] / 2, "FS-02 balance hole (axial)"))
    spec.append(("cyl", L(0, 0, M["piston"]["w"][0] + 4.9), L(0, 0, M["cross_w"] + 0.6), M["hole_d"] / 2, "FS-04 balance hole (axial)"))
    spec.append(("cyl", L(-2.0, 0, M["cross_w"]), L(2.0, 0, M["cross_w"]), M["hole_d"] / 2, "FS-04 cross hole"))
    spec.append(("cyl", L(0, 0, M["piston"]["w"][1]), L(0, 0, M["balance_top"]), M["piston"]["d"] / 2, "balance chamber"))
    # solids inside the fluid
    spec.append(("solid_cyl", L(0, 0, -M["disc"]["t"]), L(0, 0, 0.0), M["disc"]["d"] / 2, "FS-02 disc"))
    spec.append(("solid_cyl", L(0, 0, M["piston"]["w"][1] - 0.01), L(0, 0, M["balance_top"] + 0.01), M["rod"]["d"] / 2, "FS-04 rod in the balance chamber"))
    spec.append(("solid_cyl", L(0, 0, 0.0), L(0, 0, 0.31), M["seat"]["land_od"] / 2, "FS-03 seat land (closed seat)"))
    spec.append(("solid_cyl", L(0, -16.0, M["mss2_w"]), L(0, 0.0, M["mss2_w"]), 1.59 / 2, "MSS-2 sheath"))
    spec.append(("solid_cyl", np.array([ax, ay, 66.0]), np.array([ax, ay, t["z_top"] - 7.0]), 1.59 / 2, "MSS-1 sheath in the TEE"))
    # tank side boundary: the closed seat (vent = S1 check passage top when the MV is closed)
    vents = {"S1_check": L(*M["s1"]["uv"], M["s1"]["cart_w"][0] + 0.5)}
    return spec, vents


def fluid_spec_mv_open(S):
    """MV OPEN variant of the module cavity (concept d, early MV opening): disc down by the lift, seat orifice open (annulus around the
    3 mm stem through the seat insert and web up to the inlet chamber floor), vent = the orifice top (tank side).  Returns (add, remove,
    vents): primitives to add, labels of fluid_spec solids to drop, and the vent point."""
    T = module_T(S)
    L = lambda u, v, w: (T @ np.array([u, v, w, 1.0]))[:3]
    M = MOD
    lift = M["lift"]
    add = [("cyl", L(0, 0, -lift - 0.01), L(0, 0, M["web_top"]), M["seat"]["d"] / 2, "MV seat orifice (open) + curtain"),
           ("cyl", L(0, 0, -M["disc"]["t"] - lift), L(0, 0, -lift), M["hole_d"] / 2, "FS-02 balance hole in the disc (open position)"),
           ("solid_cyl", L(0, 0, -M["disc"]["t"] - lift), L(0, 0, -lift), M["disc"]["d"] / 2, "FS-02 disc (open)"),
           ("solid_cyl", L(0, 0, -lift), L(0, 0, M["web_top"] + 0.01), M["stem_d"] / 2, "FS-02 stem through the orifice (open)")]
    remove = ["FS-02 disc", "FS-03 seat land (closed seat)"]
    vents = {"MV_seat_open": L(4.0, 0.0, M["web_top"] - 0.3)}
    return add, remove, vents


