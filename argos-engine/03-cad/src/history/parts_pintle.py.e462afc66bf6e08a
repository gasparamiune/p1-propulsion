    reg.add(Part("ENG-PD-10", "Radiation shield under the HV69: 0.5 mm polished aluminium L-sheet on 2 G11 stand-offs", "AL6061-T6",
                 "cut + bend from 0.5 mm 1050A-H14 sheet, polished both faces", shp,
                 notes="servo_mount_net V3: blocks the bonnet/head-top view of the servo case bottom; emissivity <= 0.1 ASSUMED (polished); 2x M2 "
                       "through the G11 stand-offs into the servo plate; material listed as 6061 for mass (1050A same density class)")).place(T, "engine")
    so = cyl_dir(5.0, 2.0, (0.0, -15.5, 0.0), (0, 1, 0)).cut(cyl_dir(2.2, 2.2, (0.0, -15.6, 0.0), (0, 1, 0)))
    reg.add(Part("ENG-PD-20", "G11 stand-off 5/2.2 x 2 (shield to servo plate)", "G11", "turned from G11 rod", so,
                 supplier="G11 rod 6 mm (TO-QUOTE)", notes="servo_mount_net V3")).place(T_trans(-7.0, 0.0, z_c - 28.5), "engine")
    reg.parts["ENG-PD-20"].place(T_trans(7.0, 0.0, z_c - 28.5), "engine")

    # ------------------------------------------------------------------ PD-07 carriage, PD-08 MGN09H block, PD-19 rail
    za0, za1 = zbt + 1.0, zbt + 9.0                              # arm (needle clamp + link clevis)
    zp0, zp1 = zbt - 14.6, zbt + 11.4                            # plate on the MGN block
    car = union_all([box((-10.0, 14.0, zp0), (10.0, 17.0, zp1)), box((-9.0, -5.0, za0), (9.0, 14.0, za1))])
    zblk_c = zbt - 3.76                                          # block centre (closed)
    ccuts = [box((-5.5, 9.0, za0 - 0.01), (5.5, 13.0, za1 + 0.01)),                      # link slot
             cyl(3.0, za0 - 0.01, za1 + 0.01),                                           # stem M3 (modelled at the major diameter)
             cyl_dir(3.0, 12.0, (0.0, 5.0, z_k0), (0, 1, 0))]                            # link pin bore 3 H7 (y 5..17)
    for x in (-7.5, 7.5):
        for dz in (-8.0, 8.0):
            ccuts.append(cyl_dir(3.4, 4.0, (x, 13.5, zblk_c + dz), (0, 1, 0)))          # 4x M3 to the block (pattern ASSUMED 15 x 16)
    car = cut_all(car, ccuts)
    shp, T = _loc(car, z_k0)
    reg.add(Part("ENG-PD-07", "Pintle carriage: needle clamp arm (M3 stem thread) + link clevis + plate on the MGN09H block", "AL6061-T6",
                 "CNC mill, hard anodise", shp, drawing=True,
                 notes="needle stem M3 screwed into the arm (4.5 mm engagement, Loctite 243) - aluminium thread shear MS +2.7 at the jam (pintle_v2p4); "
                       "link pin 3 mm H900 through the cheek and the plate (e-clip, not modelled); 4x M3 to the block (pattern 15 x 16 ASSUMED from the "
                       "HIWIN catalogue copy, TO-VERIFY)",
                 dwg={"datum": "stem bore A, block face B", "fits": ["stem M3-6H perpendicular to B 0.02", "pin bore 3 H7 position 0.02 to A", "slot 4.0 +0.1/0"],
                      "finish": "hard anodise 25 um", "ht": "T6"})).place(T, "engine")
    blk = box((-10.0, 17.0, zblk_c - 19.95), (10.0, 25.0, zblk_c + 19.95)).cut(box((-4.6, 20.4, zblk_c - 21.0), (4.6, 25.1, zblk_c + 21.0)))
    shp, T = _loc(blk, zblk_c)
    reg.add(Part("ENG-PD-08", "Miniature linear guide block HIWIN MGN09H (C0 4020 N, M0Y 18.6 N m)", "STEEL", "COTS", shp, cots=True,
                 mass_each_kg=0.030, mass_tag="DATASHEET HIWIN MG catalogue 2023 (copy) 0.03 kg incl. rail share? - block only TO-VERIFY",
                 supplier="HIWIN MGN09H-ZF (preload ZF, end seals) via HIWIN GmbH / Misumi (TO-QUOTE, Sonderborg DK-6400)",
                 notes="moment M = 831.6 N x 11 mm = 9.15 N m at the 7.70 V jam (s0 2.0); stroke 4.2 mm; oxygen-free lubricant not required (dry side), "
                       "grease Klueber Isoflex Topas class")).place(T, "engine")
    zr0, zr1 = zbt - 24.7, zbt + 21.4
    rail = box((-4.5, 20.5, zr0), (4.5, 27.0, zr1))
    for z in (zbt - 21.5, zbt - 1.5, zbt + 18.5):
        rail = rail.cut(cyl_dir(3.5, 7.0, (0.0, 20.0, z), (0, 1, 0)))
    shp, T = _loc(rail, zr0)
    reg.add(Part("ENG-PD-19", f"Miniature rail HIWIN MGNR09R, length {zr1-zr0:.1f} mm (cut to length)", "STEEL", "COTS", shp, cots=True,
                 mass_each_kg=round(0.38 * (zr1 - zr0) * 1e-3, 4), mass_tag="DATASHEET 0.38 kg/m (HIWIN MG catalogue copy)",
                 supplier="HIWIN MGNR09R cut to 46 mm (TO-QUOTE)", notes="3x M3 x 8 into the PD-01 rail plate (pitch 20)")).place(T, "engine")

    # ------------------------------------------------------------------ PD-06 link, PD-16 pins, PD-17 bushes (closed position)
    Lk = CRANK["L"]
    lk = union_all([cyl_dir(8.0, 3.8, (0.0, -1.9, 0.0), (0, 1, 0)), cyl_dir(8.0, 3.8, (0.0, -1.9, Lk), (0, 1, 0)),
                    box((-2.0, -1.5, 0.0), (2.0, 1.5, Lk))])
    lk = cut_all(lk, [cyl_dir(4.5, 4.0, (0.0, -2.0, 0.0), (0, 1, 0)), cyl_dir(4.5, 4.0, (0.0, -2.0, Lk), (0, 1, 0))])
    # the link solid is built along local +Z; local Y is kept along the engine Y by the placement (rotation about Y only)
    Tl = _link_T(st, ph)
    reg.add(Part("ENG-PD-06", "Pintle connecting link 28 mm centres, eyes OD 8 x 3.8 with 4.5 bores, shank 4 x 3", "SS17-4PH-H1150",
                 "wire EDM from plate + ream", lk, drawing=True,
                 notes="eye net tension MS_yield +3.9 and shear-out MS +1.9 at the 7.70 V jam (pintle_v2p4); PTFE-lined bushes PD-17",
                 dwg={"datum": "eye A bore", "fits": ["centres 28.00 +/-0.02", "bores 4.5 H7 (bush press per maker)", "eye faces parallel 0.02"],
                      "finish": "passivate", "ht": "17-4PH H1150"})).place(Tl, "engine")
    bush = tube(4.5, 3.0, -1.9, 1.9)
    reg.add(Part("ENG-PD-17", "PTFE-lined steel-backed bush 3 x 4.5 x 3.8 (DU class)", "STEEL", "COTS", apply(bush, T_rot("x", -90.0)),
                 cots=True, mass_each_kg=0.0003, mass_tag="ESTIMATE 0.3 g", supplier="GGB DU / SKF PCM class 3 x 4.5 (maker part TO-SELECT, TO-QUOTE)",
                 notes="static limit ~250 MPa AS RECALLED (maker value TO-VERIFY); 69 MPa at the 7.70 V jam (pintle_v2p4)"))
    pin = cyl_dir(3.0, 12.0, (0.0, -6.0, 0.0), (0, 1, 0))
    reg.add(Part("ENG-PD-16", "Pin 3 g6 x 12 (17-4PH H900) with e-clip grooves (crank pin bush / carriage link pin)", "SS17-4PH-H900",
                 "turned + ground (or ISO 2338 3 m6 x 12 hardened)", pin, notes="link pins double shear MS_yield +4.7 at the jam (pintle_v2p4)"))
    pk = np.array([0.0, Y_LINK, z_k0])
    reg.parts["ENG-PD-17"].place(T_trans(*pk), "engine").place(T_trans(*pin_c), "engine")
    reg.parts["ENG-PD-16"].place(T_trans(0.0, Y_LINK, z_k0), "engine")
    # one PD-16 (carriage pin); the crank-side PD-17 bush runs on the pin integral with PD-04
    S["pintle_geom"] = dict(z_c=z_c, z_k0=z_k0, y_l=Y_LINK, rc=CRANK["r"], Lk=Lk, phi_closed_deg=ph, s0=st["s0"],
                            stroke_stop_mm=round(st["s0"] - slider_s(CRANK["phi_stop_deg"]), 3), z_needle_top=S["z_needle_top"],
                            hv69_case_z=(zc0, zc1), frame_top=z_cap1, cover_y=(cy0, cy1))
    return st


def moving_parts_at(reg, S, phi_deg):
    """Posed shapes of the pintle moving train at crank angle phi (deg): [(pn, idx, shape)].  Slider items translate by the
    slider travel, crank items rotate about the crank axis, the link is re-placed.  Used by the stroke check (make_all)."""
    st = S["pintle_v34"]
    ph0 = CRANK["phi_closed_deg"]
    dz = slider_s(ph0) - slider_s(phi_deg)                         # + = needle moves away from the seat (opening)
    z_c = st["z_c"]
    Rc = T_trans(0.0, 0.0, z_c) @ T_rot("y", -(phi_deg - ph0)) @ T_trans(0.0, 0.0, -z_c)
    out = []
    for pn in ("ENG-PD-04", "ENG-PD-05", "ENG-PD-18", "ENG-PD-09"):
        p = reg.get(pn)
        for i, (T, g) in enumerate(p.placements):
            out.append((pn, i, apply(p.shape, Rc @ T)))
    for pn in ("ENG-PD-07", "ENG-PD-08", "ENG-TC-05"):
        p = reg.get(pn)
        for i, (T, g) in enumerate(p.placements):
            out.append((pn, i, apply(p.shape, T_trans(0, 0, dz) @ T)))
    p = reg.get("ENG-PD-16")
    out.append(("ENG-PD-16", 0, apply(p.shape, T_trans(0, 0, dz) @ p.placements[0][0])))
    p = reg.get("ENG-PD-17")
    out.append(("ENG-PD-17", 0, apply(p.shape, T_trans(0, 0, dz) @ p.placements[0][0])))
    out.append(("ENG-PD-17", 1, apply(p.shape, T_trans(*crank_pin(st, phi_deg)))))
    p = reg.get("ENG-PD-06")
    out.append(("ENG-PD-06", 0, apply(p.shape, _link_T(st, phi_deg, dz))))
    return out, dz
