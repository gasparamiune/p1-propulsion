  (text "Safety chain: arming plug (physical) -> fused ARM bus switch = ARM_REQ AND watchdog OK AND OVP_OK -> ARM-only 5 V gate rail."
    (at 20.32 53.34 0)
    (effects (font (size 1.4 1.4)) (justify left bottom))
    (uuid 464be842-3f45-5fdc-bcd9-7833a0796dac)
  )
  (text "OVP_OK: LMV331 comparator on PC_SIG (~31 bar g, ratiometric) clears a 74LVC1G175 latch; only an ARM_REQ rising edge sets it."
    (at 20.32 57.15 0)
    (effects (font (size 1.4 1.4)) (justify left bottom))
    (uuid aa424d3c-5a65-5c94-adc1-9edfdc001aad)
