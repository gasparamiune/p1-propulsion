 // ------------------------------------------------------------------------------------- Pc sense line (v2.1)
+SenseLineParams seatPassage(double L, double c, double V_end_mm3) {   // v2.11 (plant.h)
+  SenseLineParams sp;
+  sp.L = L; sp.ID = 2.044e-3; sp.V_end = V_end_mm3 * 1e-9; sp.N = 24; sp.n_poly = 1.15;   // N 24: ladder cutoff >= 30 kHz
+  sp.M = c < 300 ? 0.044 : 0.0235;                     // N2O vapour / products molar mass [ASSUMED]
+  sp.T = c * c * sp.M / (sp.n_poly * 8.314462618);     // gas temperature that gives the bracket sound speed c
+  sp.mu = 1.5e-5;
+  sp.enabled = true;
+  return sp;
+}
 SenseLine::SenseLine(const SenseLineParams& p) : P(p) {}
 double SenseLine::c() const { return std::sqrt(P.n_poly * 8.314462618 * P.T / P.M); }
 void SenseLine::init(double p0) { p_.assign(P.N, p0); q_.assign(P.N, 0.0); }
