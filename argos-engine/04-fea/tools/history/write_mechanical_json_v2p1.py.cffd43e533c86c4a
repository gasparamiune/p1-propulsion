def sha(p):
    return hashlib.sha256(Path(p).read_bytes()).hexdigest()[:16] if Path(p).exists() else "MISSING"


def load(k):
    p = SRC[k]
    return json.loads(p.read_text()) if p.exists() else None


def per_part(res, cases):
    """Min yield MS (regular set) and the ultimate MS on the same record, per part and case, with the role criterion."""
    out = {}
    for g in res["governing"]:
        if g["case"] not in cases or g.get("set") != "regular":
            continue
        k = (g["part"], g["case"])
        if k not in out or g["MS"] < out[k]["MS_yield"]:
            out[k] = {"MS_yield": round(g["MS"], 3), "MS_ult": None if g.get("MS_ult") is None else round(g["MS_ult"], 3),
                      "MS_primary_only": None if g.get("MS_primary_only") is None else round(g["MS_primary_only"], 3),
                      "state": g["state"], "T_C": round(g.get("T_C", float("nan")), 1), "role": g.get("role"), "criterion": g.get("role_criterion")}
    tab = {}
    for (pn, c), v in sorted(out.items()):
        tab.setdefault(pn, {})[c] = v
    return tab


def element_curve():
    """FD-01 leg element (BL-02) dP-flow, equivalent-orifice ESTIMATE: dP = (mdot / CdA)^2 / (2 rho).  Bench measures the real curve."""
    rho = {"liquid_N2O_20C": 786.0, "vapour_N2O_20C_sat": 160.0}     # kg/m3, AS RECALLED (NIST WebBook saturation, TO-VERIFY)
    rows = []
    for cda in (1.57, 0.63):
        for fl, r in rho.items():
            for md in (2.0, 5.0, 10.0, 20.0, 30.0):                   # g/s
                dp = (md * 1e-3 / (cda * 1e-6)) ** 2 / (2.0 * r) / 1e5
                rows.append({"CdA_mm2": cda, "fluid": fl, "mdot_g_s": md, "dP_bar": round(dp, 3)})
    r2 = 0.62 * math.pi / 4 * 0.71 ** 2
    return {"model": "equivalent orifice dP = (mdot/CdA)^2/(2 rho); incompressible; ESTIMATE (no media data), bench B-EL-02 measures it",
            "acceptance": "CdA >= 1.57 mm2 (lead F2) at the rated flow; Combustion's check holds down to CdA ~0.63 mm2",
            "R2_CdA_mm2_for_reference": round(r2, 3), "R2_CdA_note": "Cd 0.62 ASSUMED sharp-edged; series dP share of the element "
            f"= (R2/element)^2 = {round((r2 / 1.57) ** 2, 3)} at 1.57 mm2, {round((r2 / 0.63) ** 2, 3)} at 0.63 mm2", "rho_kg_m3": rho, "rows": rows}


